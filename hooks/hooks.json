  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/orient.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
